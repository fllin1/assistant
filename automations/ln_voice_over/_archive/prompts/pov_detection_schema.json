{
  "type": "json_schema",
  "json_schema": {
    "name": "pov_detection",
    "strict": true,
    "schema": {
      "type": "object",
      "properties": {
        "pov_character": {
          "type": "string",
          "description": "Full name of the narrator"
        },
        "pov_ranges": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "start_line": { "type": "integer" },
                  "end_line": {
                    "anyOf": [{ "type": "integer" }, { "type": "null" }]
                  },
                  "pov": { "type": "string" }
                },
                "required": ["start_line", "end_line", "pov"],
                "additionalProperties": false
              }
            },
            { "type": "null" }
          ]
        }
      },
      "required": ["pov_character", "pov_ranges"],
      "additionalProperties": false
    }
  }
}
